<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E2028"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CAR LOCATOR"
            android:textColor="#8B92A3"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="No spot saved"
        android:textColor="#F2F3F7"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Park and disconnect to save one"
        android:textColor="#8B92A3"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/widget_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_maps_button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_pill_button"
            android:text="Maps"
            android:textAllCaps="false"
            android:textColor="#1A1400"
            android:textSize="13sp"
            android:textStyle="bold"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/widget_waze_button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_button"
            android:text="Waze"
            android:textAllCaps="false"
            android:textColor="#1A1400"
            android:textSize="13sp"
            android:textStyle="bold"
            android:minWidth="0dp"
            android:minHeight="0dp" />

    </LinearLayout>

</LinearLayout>
